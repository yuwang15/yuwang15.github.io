{
  "name": "syw-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && python3 scripts/prerender-seo.py",
    "images:og": "python3 scripts/build-og-images.py",
    "lint": "oxlint",
    "preview": "vite preview",
    "images:stores": "python3 scripts/build-store-listing-images.py",
    "images:responsive": "python3 scripts/build-responsive-images.py",
    "fonts:vendor": "python3 scripts/vendor-google-fonts.py",
    "deploy:cn": "bash scripts/deploy-cn.sh",
    "deploy:global": "npm run images:responsive && vercel --prod",
    "deploy": "npm run deploy:global && npm run deploy:cn"
  },
  "dependencies": {
    "framer-motion": "^13.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
